cabal-version: 3.0
name: x14-state
version: 0.1.0.0
license: NONE
build-type: Simple
extra-doc-files: "Monad recap.pdf"

common warnings
  ghc-options:
    -Wall
    -Wno-type-defaults
    -Wno-missing-signatures
    -Wno-name-shadowing

library
  import: warnings
  exposed-modules:
    Exercises
    Lecture

  build-depends:
    base ^>=4.18.3.0,
    random,

  hs-source-dirs: src
  default-language: Haskell2010
